---
description: "Fix one cluster inside its own git worktree - the manifest runs as SEQUENTIAL small batches (fixer/gate/review/commit per batch, each its own revert boundary), squashed to one commit at lane end; never touches the quality store"
mode: subagent
model: "anthropic/claude-sonnet-5"
tools:
  - bash
  - theta_progress
  - ./fix-cluster.theta
  - ./review-fix.theta
params:
  manifest_src: string
  key: string
  wave: string
  gate_cmd: string
  retry_context: string
  batch: integer = 4
---
// Runs with cwd == its own git worktree (the orchestrator dispatches it as
// `fix_cluster_tree(...) with { cwd: tree }`), so every side effect of a fix
// attempt - edits, gate runs, the commits - stays in that one tree and cannot
// collide with a sibling fixer. The two workers it calls inherit that cwd,
// which is why they need no change: their repo-relative paths and git commands
// resolve against the tree. See docs/how-to/fan-out-into-git-worktrees.md.
//
// BATCHED LANES (2026-09-18). A lane may own many issues (an oversized glued
// component drains through one lane per wave), but gate/review rejection
// probability grows with batch size and a rejection re-gates and re-reviews
// EVERYTHING - one stubborn issue among ten sinks nine good fixes at the
// attempt-2 revert. So the manifest runs as SEQUENTIAL batches of `batch`
// issues: each batch gets the full fixer -> gate -> review -> commit cycle
// and its own revert boundary (a double-rejected batch is reset --hard away
// and the lane moves on; committed predecessors are untouchable history).
// The worktree setup, the cherry-pick, and the orchestrator's integration
// contract amortise across batches: at lane end the committed batches are
// SQUASHED into one commit via `git reset --soft <base>` + an INDEX commit -
// deliberately no `git add`, so stray working-tree writes (a bug-0484
// orphaned fixer racing the lane) can never leak into the reported sha.
//
// This wrapper is code-only: it drives workers and gates and never takes a
// turn of its own. The `theta_progress` calls are the narrative channel that
// makes it watchable (PIC-74 / EXST-15), placed at batch/attempt/gate/review/
// commit boundaries only.
import { FixReport, FixReview, TreeFixReport, lines } from "./quality.thetalib"

// Manifest transport. The cluster manifest is written under quality/tmp/,
// which is gitignored - so the worktree's HEAD checkout does NOT carry it,
// while the issue files it lists (quality/issues/*.md) ARE committed and
// therefore present in this tree. Copying the main tree's manifest into this
// tree's own quality/tmp/ keeps fix-cluster.theta and review-fix.theta reading
// a repo-relative manifest path exactly as they do in the main tree, and the
// copy is invisible to git (gitignored), so it cannot reach any commit.
let man = "quality/tmp/tree-cluster.txt"
let staged = match bash({ command: "mkdir -p quality/tmp && cp \"" + manifest_src + "\" " + man + " && wc -l < " + man }) {
  Ok(_) => true,
  Err(_) => false,
}
if !staged {
  return TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: "could not stage the cluster manifest into the worktree: " + manifest_src, fixer_notes: "" }
}

// Bug 0474 belt. This wrapper runs INSIDE a subagent child, so its own process
// environment carries the PI_THETA_* control plane of the invocation that
// launched it. The gate below must measure the CODE, not the wrapper's session
// context: a leaked root marker / hash map / params carrier reaches the real
// child pi processes the test suite spawns, whose parent-pid gate legitimately
// authenticates it, and the suite reds fail-closed on a foreign invocation's
// data (subagent.md #subagent-launch-contract, docs/bugs/0474). Every per-launch
// control-plane var is dropped from the gate shell; the extension pin is NOT -
// it is heritable by design and the harnesses depend on it
// (AGENTS.md #subagent-child-pins).
let env_scrub = "unset PI_THETA_SUBAGENT_ROOT PI_THETA_SUBAGENT_ROOT_WINNER PI_THETA_PARAMS PI_THETA_PARAMS_FILE PI_THETA_SUBAGENT_INVOKE_DEPTH PI_THETA_SUBAGENT_CALLABLE_HASHES PI_THETA_SUBAGENT_PARENT_PID; "

// The lane's base commit: the squash target, and the "nothing committed yet"
// sentinel for the abort paths.
let base = bash({ command: "git rev-parse HEAD" })?.trim()

let mut all_issues: array<string> = []
all_issues = lines(bash({ command: "cat " + man })?)

let mut confirmed: array<string> = []
let mut notes = ""
let mut fixer_notes = ""
let mut batches_committed = 0
let mut lane_aborted = ""

let mut start = 0
while start < all_issues.length && lane_aborted == "" {
  let mut end = start + batch
  if end > all_issues.length {
    end = all_issues.length
  }
  let mut chunk: array<string> = []
  chunk = all_issues.slice(start, end)
  start = end
  // The batch label is its first issue's basename - strings end to end (theta
  // has no number->string concat).
  let mut lbl: array<string> = []
  lbl = chunk[0].split("/")
  let label = lbl[lbl.length - 1]
  // Issue paths are repo-relative, shell-safe (no spaces); the sub-manifest is
  // written by printf in the tree's own gitignored quality/tmp/.
  let subman = "quality/tmp/tree-batch.txt"
  let _ = bash({ command: "printf '%s\\n' " + chunk.join(" ") + " > " + subman })?
  // The pre-batch boundary: a double-rejected batch resets --hard here (plus a
  // clean of untracked fixer leftovers, or they leak into the NEXT batch's
  // add -A commit); committed predecessors stay behind it.
  let boundary = bash({ command: "git rev-parse HEAD" })?.trim()

  let mut attempt = 0
  let mut guidance = retry_context
  let mut done = false
  let mut trail = ""
  while attempt < 2 && !done && lane_aborted == "" {
    attempt += 1
    let att = attempt == 1 ? "1" : "2"
    let _ = theta_progress({ message: "batch " + label + " attempt " + att + ": fixing " + key, scope: key })?
    let fr_result = fix_cluster(subman, guidance, gate_cmd)
    // A failed fixer INVOKE aborts the whole lane - no gate, no review, no
    // further batches. The Err says nothing about the tree: a
    // heartbeat-silence / channel-close settle abandons a child that is often
    // STILL RUNNING (bug 0484 - a reviewer watched "code changing under its
    // feet"; an orphan span at 100% core). Committed predecessor batches are
    // safe git history and are still squashed and reported below.
    let fixer_err = match fr_result {
      Ok(f) => "",
      Err(e) => e.kind,
    }
    if fixer_err != "" {
      lane_aborted = "fixer invoke failed (" + fixer_err + ") on batch " + label + " attempt " + att + "; lane aborted - tree state unknown and the abandoned fixer child may still be editing it (orphan; bug 0484)."
      let _ = theta_progress({ message: "fixer invoke FAILED (" + fixer_err + ") - lane aborted: " + key, scope: key })?
    } else {
      let fr = match fr_result {
        Ok(f) => f,
        Err(e) => FixReport { fixed: [], skipped: [], notes: "unreachable: fixer_err aborted above" },
      }
      let _ = theta_progress({ message: "batch " + label + ": gating " + key, scope: key })?
      // The gate is bounded (the orchestrator passes a test-runner-width-capped
      // gate_cmd). Output goes to a gitignored in-tree log so a red gate is
      // DIAGNOSABLE: the failing tail feeds attempt 2's guidance and the notes.
      let gate = match bash({ command: env_scrub + "{ " + gate_cmd + " ; } > quality/tmp/gate.log 2>&1 && echo GATE_PASS || echo GATE_FAIL", timeout: 3600 }) {
        Ok(g) => g,
        Err(e) => "GATE_FAIL gate-bash-error: " + e.kind + " - " + e.message,
      }
      let gate_tail = gate.includes("GATE_PASS") ? "" : match bash({ command: env_scrub + "{ grep -E 'FAIL|failed|Error' quality/tmp/gate.log | head -25 ; tail -c 1500 quality/tmp/gate.log ; } 2>/dev/null" }) {
        Ok(t) => t,
        Err(e) => "(gate log unavailable: " + e.kind + ")",
      }
      let gate_state = gate.includes("GATE_PASS") ? "green" : (gate.includes("gate-bash-error:") ? gate : "red")
      let _ = theta_progress({ message: "batch " + label + ": gate " + gate_state, scope: key })?
      trail = trail + "attempt " + att + ": gate " + gate_state + "; "
      let rv = match review_fix(subman) {
        Ok(r) => r,
        Err(e) => FixReview { ok: false, fixed_confirmed: [], must_fix: "fix-review worker failed: " + e.kind + " - fixer notes were: " + fr.notes, unconfirmed: "" },
      }
      let _ = theta_progress({ message: "batch " + label + ": review " + (rv.ok ? "confirmed" : "rejected"), scope: key })?
      if gate.includes("GATE_PASS") && rv.ok && rv.fixed_confirmed.length > 0 {
        // Single-writer rule: the tree commits code only. Any stray quality/
        // edit is unstaged before the commit so the store stays the
        // orchestrator's.
        let committed = bash({ command: "git add -A && git restore --staged -- quality >/dev/null 2>&1; git commit -q -m \"quality: " + wave + " fix " + key + " batch " + label + "\" >/dev/null 2>&1 && git rev-parse HEAD || echo COMMIT_FAIL" })?
        if committed.includes("COMMIT_FAIL") {
          notes = notes + "[" + label + "] in-tree commit failed after a green gate and a confirming review. "
          let _ = theta_progress({ message: "batch " + label + ": commit FAILED", scope: key })?
          done = true
        } else {
          batches_committed += 1
          confirmed = confirmed.concat(rv.fixed_confirmed)
          done = true
          fixer_notes = fixer_notes + "[" + label + "] " + fr.notes + (rv.must_fix == "" ? "" : " | review: " + rv.must_fix) + (rv.unconfirmed == "" ? "" : " | review unconfirmed: " + rv.unconfirmed) + " || "
          notes = notes + "[" + label + "] gate green, review confirmed " + rv.fixed_confirmed.join(",") + " on attempt " + att + ". "
          let _ = theta_progress({ message: "batch " + label + ": committed", scope: key })?
        }
      } else {
        trail = trail + "review ok=" + (rv.ok ? "true" : "false") + ", confirmed " + (rv.fixed_confirmed.length == 0 ? "none" : rv.fixed_confirmed.join(",")) + (rv.must_fix == "" ? "" : ", must_fix: " + rv.must_fix) + "; fixer: " + fr.notes + " | "
        // A retry's seed stays in front of the review's must_fix: attempt 2
        // must still know the tree already holds prior batches' changes.
        guidance = "ATTEMPT 2 (LAST): " + (retry_context == "" ? "" : retry_context + " ") + rv.must_fix + (gate.includes("GATE_PASS") ? "" : " ALSO: the offline gate is red after your changes - make it green. Gate failures (tail): " + gate_tail + " -- If a census/pin/inventory gate reds, its own failure message names the sanctioned same-commit re-derivation - follow it rather than avoiding the edit.")
        if attempt >= 2 {
          // Batch revert boundary: reset to the pre-batch commit and clean the
          // failed attempt's untracked leftovers (a new helper module etc.) so
          // they cannot leak into the NEXT batch's `git add -A` commit.
          // quality/ is excluded: the manifests and gate log live there
          // (gitignored) and the next batch still needs them.
          let _ = theta_progress({ message: "batch " + label + ": reverting after 2 rejected attempts", scope: key })?
          let restore_ok = match bash({ command: "git reset --hard " + boundary + " >/dev/null 2>&1 && git clean -fd -e quality >/dev/null 2>&1; git status --porcelain | wc -l" }) {
            Ok(n) => n.trim() == "0",
            Err(e) => false,
          }
          if restore_ok {
            notes = notes + "[" + label + "] 2 rejected fix attempts, batch reverted. Trail: " + trail + " "
          } else {
            let residue = bash({ command: "git status --porcelain | head -10" })?
            notes = notes + "[" + label + "] 2 rejected attempts; UNCLEAN batch revert (leftovers: " + residue.trim() + ") - lane halted to protect later batches. Trail: " + trail + " "
            lane_aborted = "unclean batch revert at " + label
          }
        }
      }
    }
  }
}

// Lane end: squash the committed batches into ONE reported commit. `reset
// --soft` moves HEAD to base while the INDEX still holds the last batch
// commit's tree; committing the index (no `git add`) reproduces exactly that
// tree - stray post-batch working-tree writes (an orphaned fixer racing this
// lane, bug 0484) cannot reach it. The orchestrator's contract (one sha,
// cherry-picked) is unchanged.
let mut out = TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: notes + lane_aborted, fixer_notes: fixer_notes }
if batches_committed > 0 {
  let squashed = bash({ command: "git reset --soft " + base + " >/dev/null 2>&1 && git commit -q -m \"quality: " + wave + " fix " + key + "\" >/dev/null 2>&1 && git rev-parse HEAD || echo SQUASH_FAIL" })?
  if squashed.includes("SQUASH_FAIL") {
    out = TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: notes + lane_aborted + " SQUASH FAILED at lane end - tree discarded, no integration.", fixer_notes: fixer_notes }
  } else {
    out = TreeFixReport { ok: true, sha: squashed.trim(), fixed_confirmed: confirmed, notes: notes + (lane_aborted == "" ? "" : "LANE ABORTED after " + lane_aborted + " - committed batches up to the abort are included. "), fixer_notes: fixer_notes }
  }
}
out
