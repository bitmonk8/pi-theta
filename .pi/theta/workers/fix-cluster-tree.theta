---
description: "Fix one cluster inside its own git worktree - up to 2 attempts behind a bounded gate, one in-tree commit once green, never touches the quality store"
mode: subagent
model: "anthropic/claude-sonnet-5"
tools:
  - bash
  - theta_progress
  - ./fix-cluster.theta
  - ./review-fix.theta
params:
  manifest_src: string
  key: string
  wave: string
  gate_cmd: string
---
// Runs with cwd == its own git worktree (the orchestrator dispatches it as
// `fix_cluster_tree(...) with { cwd: tree }`), so every side effect of a fix
// attempt - edits, gate runs, the commit - stays in that one tree and cannot
// collide with a sibling fixer. The two workers it calls inherit that cwd,
// which is why they need no change: their repo-relative paths and git commands
// resolve against the tree. See docs/how-to/fan-out-into-git-worktrees.md.
//
// This wrapper is code-only: it drives two workers and a gate and never takes
// a turn of its own, so the parent's child-activity tap sees no model traffic
// for minutes at a time and the lane looks dead. The `theta_progress` calls
// below are the narrative channel that makes it watchable - running in the
// child regime each accepted call is exactly one PIC-74 stdout wire line, and
// the parent's tap renders it per-lane as the class-2 segment (EXST-15). They
// are placed at attempt/gate/review/commit boundaries only: each is separated
// from the next by a worker invocation or a gate run, so the EXST-14 200 ms
// inter-acceptance clamp drops none of them in practice.
// See docs/how-to/report-progress-from-a-theta.md.
import { FixReport, FixReview, TreeFixReport } from "./quality.thetalib"

// Manifest transport. The cluster manifest is written under quality/tmp/,
// which is gitignored - so the worktree's HEAD checkout does NOT carry it,
// while the issue files it lists (quality/issues/*.md) ARE committed and
// therefore present in this tree. Copying the main tree's manifest into this
// tree's own quality/tmp/ keeps fix-cluster.theta and review-fix.theta reading
// a repo-relative manifest path exactly as they do in the main tree, and the
// copy is invisible to git (gitignored), so it cannot reach the commit.
let man = "quality/tmp/tree-cluster.txt"
let staged = match bash({ command: "mkdir -p quality/tmp && cp \"" + manifest_src + "\" " + man + " && wc -l < " + man }) {
  Ok(_) => true,
  Err(_) => false,
}
if !staged {
  return TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: "could not stage the cluster manifest into the worktree: " + manifest_src }
}

// Bug 0474 belt. This wrapper runs INSIDE a subagent child, so its own process
// environment carries the PI_THETA_* control plane of the invocation that
// launched it. The gate below must measure the CODE, not the wrapper's session
// context: a leaked root marker / hash map / params carrier reaches the real
// child pi processes the test suite spawns, whose parent-pid gate legitimately
// authenticates it, and the suite reds fail-closed on a foreign invocation's
// data (subagent.md #subagent-launch-contract, docs/bugs/0474). Every per-launch
// control-plane var is dropped from the gate shell; the extension pin is NOT -
// it is heritable by design and the harnesses depend on it
// (AGENTS.md #subagent-child-pins).
let env_scrub = "unset PI_THETA_SUBAGENT_ROOT PI_THETA_SUBAGENT_ROOT_WINNER PI_THETA_PARAMS PI_THETA_PARAMS_FILE PI_THETA_SUBAGENT_INVOKE_DEPTH PI_THETA_SUBAGENT_CALLABLE_HASHES PI_THETA_SUBAGENT_PARENT_PID; "

let mut attempt = 0
let mut guidance = ""
let mut done = false
let mut sha = ""
let mut confirmed: array<string> = []
let mut notes = ""
let mut trail = ""

while attempt < 2 && !done {
  attempt += 1
  // A number cannot be concatenated with a string in theta; the attempt index
  // is bounded at 2, so a ternary spells it (the same idiom the notes below use).
  let att = attempt == 1 ? "1" : "2"
  let _ = theta_progress({ message: "attempt " + att + ": fixing " + key, scope: key, done: attempt, total: 2 })?
  let fr = match fix_cluster(man, guidance) {
    Ok(f) => f,
    Err(e) => FixReport { fixed: [], skipped: [], notes: "fix worker failed: " + e.kind },
  }
  let _ = theta_progress({ message: "gating " + key, scope: key, done: attempt, total: 2 })?
  // The gate is bounded (the orchestrator passes a test-runner-width-capped
  // gate_cmd): N trees x M runner workers must stay under the core budget.
  // Gate output goes to a gitignored in-tree log so a red gate is
  // DIAGNOSABLE: the failing tail feeds attempt 2's guidance and the final
  // notes. (A user-supplied gate_cmd carrying its own >/dev/null redirects
  // degrades to the old blind behaviour - the log is then empty.)
  let gate = bash({ command: env_scrub + "{ " + gate_cmd + " ; } > quality/tmp/gate.log 2>&1 && echo GATE_PASS || echo GATE_FAIL", timeout: 3600 })?
  let gate_tail = gate.includes("GATE_PASS") ? "" : bash({ command: env_scrub + "{ grep -E 'FAIL|failed|Error' quality/tmp/gate.log | head -25 ; tail -c 1500 quality/tmp/gate.log ; } 2>/dev/null" })?
  let _ = theta_progress({ message: "gate " + (gate.includes("GATE_PASS") ? "green" : "red") + ": " + key, scope: key, done: attempt, total: 2 })?
  trail = trail + "attempt " + att + ": gate " + (gate.includes("GATE_PASS") ? "green" : "red") + "; "
  let rv = match review_fix(man) {
    Ok(r) => r,
    Err(e) => FixReview { ok: false, fixed_confirmed: [], must_fix: "fix-review worker failed: " + e.kind + " - fixer notes were: " + fr.notes },
  }
  let _ = theta_progress({ message: "review " + (rv.ok ? "confirmed" : "rejected") + ": " + key, scope: key, done: attempt, total: 2 })?
  if gate.includes("GATE_PASS") && rv.ok && rv.fixed_confirmed.length > 0 {
    // Single-writer rule: the tree commits code only. Any stray quality/ edit
    // is unstaged before the commit so the store stays the orchestrator's.
    let committed = bash({ command: "git add -A && git restore --staged -- quality >/dev/null 2>&1; git commit -q -m \"quality: " + wave + " D2 fix " + key + "\" >/dev/null 2>&1 && git rev-parse HEAD || echo COMMIT_FAIL" })?
    if committed.includes("COMMIT_FAIL") {
      notes = "in-tree commit failed after a green gate and a confirming review"
      let _ = theta_progress({ message: "commit FAILED: " + key, scope: key, done: attempt, total: 2 })?
    } else {
      sha = committed.trim()
      confirmed = rv.fixed_confirmed
      done = true
      notes = "gate green, review confirmed " + rv.fixed_confirmed.join(",") + " on attempt " + att
      let _ = theta_progress({ message: "committed " + key + " @ " + sha, scope: key, done: attempt, total: 2 })?
    }
  } else {
    trail = trail + "review ok=" + (rv.ok ? "true" : "false") + ", confirmed " + (rv.fixed_confirmed.length == 0 ? "none" : rv.fixed_confirmed.join(",")) + (rv.must_fix == "" ? "" : ", must_fix: " + rv.must_fix) + "; fixer: " + fr.notes + " | "
    guidance = rv.must_fix + (gate.includes("GATE_PASS") ? "" : " ALSO: the offline gate is red after your changes - make it green. Gate failures (tail): " + gate_tail + " -- If a census/pin/inventory gate reds, its own failure message names the sanctioned same-commit re-derivation - follow it rather than avoiding the edit.")
    if attempt >= 2 {
      // Same revert boundary as the single-tree loop had, now per tree: undo
      // the rejected attempt and report leftovers loudly rather than commit
      // them. The tree itself is discarded by the orchestrator either way, so
      // an unclean revert here cannot poison the main tree - it is reported,
      // not a halt.
      let _ = theta_progress({ message: "reverting " + key + " after 2 rejected attempts", scope: key, done: 2, total: 2 })?
      let _ = bash({ command: "git restore ." })?
      let residue_n = bash({ command: "git status --porcelain | wc -l" })?
      notes = "2 rejected fix attempts, reverted in-tree. Trail: " + trail
      if residue_n.trim() != "0" {
        let residue = bash({ command: "git status --porcelain | head -20" })?
        notes = "2 rejected fix attempts; UNCLEAN in-tree revert (leftovers below, worktree discarded): " + residue.trim() + " | Trail: " + trail
      }
    }
  }
}

// Tail value. An `if` is a STATEMENT in theta — a trailing if/else's branch
// values go nowhere and the callee's final value would be null (the exact
// shape of the 2026-09-10 abort: Ok(null) crossing PIC-59, then `.ok` panics
// in the orchestrator). Bind, then end on a bare expression tail like
// fix-cluster.theta's `r`.
let mut out = TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: notes }
if done {
  out = TreeFixReport { ok: true, sha: sha, fixed_confirmed: confirmed, notes: notes }
}
out
