---
description: Rank open bugs with fix-order guidance, fix ONE numbered bug, or resume a paused run
argument-hint: "[bug number | resume [bug number]] [ship true/false] [review_rounds 5]"
mode: prompt
tools:
  - bash
  - read
  - write
  - theta_print
  - ./workers/bugfix-stage.theta
  - ./workers/bugfix-review.theta
  - ./workers/bugfix-rank.theta
  - ./workers/bugfix-decide.theta
params:
  arguments: string
---
fn shell_path(path: string): string {
  "'" + path.replace("'", "'\\''") + "'"
}
// theta_print renders plain text, not Markdown. Keep labels and line breaks
// deterministic; workers provide concise evidence-based answers, not a wall of text.
fn stop_report(bug: string, stage: string, reason: string, environment: string,
  validity: string, fixability: string, progress: string, action: string,
  recommendation: string, artifacts: string): string {
  "STOP — Bug " + bug + "\n"
    + "Stopped at:     " + stage + "\n"
    + "Reason:         " + reason + "\n"
    + "Environment:    " + environment + "\n"
    + "Bug valid:      " + validity + "\n"
    + "Fixable:        " + fixability + "\n"
    + "Progress:       " + progress + "\n"
    + "You need to:    " + action + "\n"
    + "Recommendation: " + recommendation + "\n"
    + "Artifacts:      " + artifacts
}
// A failed mechanical checkpoint cannot diagnose an environment or code bug.
// Be explicit about that uncertainty instead of interpreting a nonzero exit.
fn checkpoint_stop(bug: string, stage: string, reason: string, action: string,
  recommendation: string, artifacts: string): string {
  stop_report(bug, stage, reason,
    "Unknown — this checkpoint does not classify the cause.",
    "Not reassessed at this checkpoint; see the reproduction/diagnosis reports.",
    "Not determined by this stop; a blocked gate does not mean unfixable.",
    "Halted at this checkpoint; subsequent stages did not run. No completion is claimed.",
    action, recommendation, artifacts)
}
// Same wire shape as the stage worker; fallback values keep transport failures
// on the same card surface and preserve the orchestrator's known stage.
schema StageFailure {
  status: "pass" | "blocked" | "not_reproduced" | "needs_spec" | "needs_decision",
  summary: string, environment: string, bug_validity: string, fixability: string,
  progress: string, next_action: string, recommendation: string
}
fn error_reason(error: QueryError): string {
  if error.kind == "invoke_callee" { return error.inner.message }
  error.message
}
fn worker_failure(message: string): StageFailure {
  StageFailure { status: "blocked", summary: message,
    environment: "Unknown — worker execution failed; no stage verdict was returned.",
    bug_validity: "Unknown from this failure; retain earlier reproduction evidence.",
    fixability: "Unknown from this failure; not evidence that the bug cannot be fixed.",
    progress: "Worker did not return a verdict; partial edits may exist. Later stages did not run.",
    next_action: "Inspect this stage's report and checkout before continuing.",
    recommendation: "Resolve the worker failure and preserve partial work; do not restart blindly." }
}
// Do not infer shell success from tool Ok: some hosts render a nonzero exit
// as ordinary text. Every control-plane operation must return the exact PASS.
fn control(command: string): boolean {
  let output: string = match bash({ command: command }) {
    Ok(text) => text,
    Err(_) => "CONTROL_ERROR",
  }
  output.trim() == "PASS"
}
// Spawn workers in the actual isolated checkout, not merely prompt them to cd.
// Run artifacts remain in the original checkout and survive worktree cleanup.
fn worktree(run: string) {
  let tree = bash({ command: "node -e 'process.stdout.write(JSON.parse(require(\"node:fs\").readFileSync(process.argv[1],\"utf8\")).root)' " + shell_path(run + "/state.json") })?.trim()
  if !tree.startsWith("/") || tree.includes("\n") { return "" }
  tree
}
// Cache only durably recorded successful stages. Blocked/interrupted stages
// rerun; original red proof and fresh verification/reviews stay controller-owned.
fn stage_attempt(run: string, phase: string, feedback: string) {
  let command = "node tools/bugfix/run.mjs "
  let quoted = shell_path(run)
  let cached = bash({ command: command + "cached " + quoted + " " + phase })?
  if cached.trim() == "PASS" {
    let fields = read({ path: run + "/stage-" + phase + "-result.txt" })?.split("\n")
    return StageFailure { status: fields[0] == "needs_spec" ? "needs_spec" : "pass",
      summary: fields.slice(1).join("\n"), environment: "Not applicable — recorded completed stage.",
      bug_validity: "See preserved reproduction/diagnosis evidence.", fixability: "See the recorded plan.",
      progress: "Reused validated stage checkpoint; gates and reviews still run fresh.",
      next_action: "Continue the recorded workflow.", recommendation: "Preserve the original evidence." }
  }
  if cached.trim() != "RUN" { return worker_failure("Checkpoint validation failed: " + cached) }
  if !control(command + "begin " + quoted + " " + phase) { return worker_failure("Could not begin stage checkpoint: " + phase) }
  let tree = worktree(run)?
  if tree == "" { return worker_failure("Invalid isolated worktree path in state.json") }
  let result = match bugfix_stage(run, phase, feedback) with { cwd: tree } {
    Ok(value) => value,
    Err(error) => worker_failure(error_reason(error)),
  }
  write({ path: run + "/stage-" + phase + "-result.txt", content: result.status + "\n" + result.summary })?
  if !control(command + "record " + quoted + " " + phase) { return worker_failure("Could not record stage result: " + phase) }
  result
}
// Astra chooses exact scoped implementation decisions, including provisional
// tradeoffs. Owner approval is deferred until every review/gate has passed;
// provisional authority never grants shipment or gate waivers.
// Persist its typed value without an extra model formatting/explanation turn.
schema DecisionRecord {
  disposition: "continue" | "human" | "blocked",
  clear_preference: boolean, has_tradeoff: boolean, evidence_sufficient: boolean,
  summary: string, recommendation: string, rationale: string,
  basis: array<string>, alternatives: array<string>
}
schema DecisionOutcome { proceed: boolean, feedback: string, context_path: string }
fn json_string(value: string): string {
  "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"")
    .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + "\""
}
fn json_strings(values: array<string>): string {
  let mut body = ""
  for value in values {
    if body != "" { body += "," }
    body += json_string(value)
  }
  "[" + body + "]"
}
fn decision_json(value: DecisionRecord): string {
  "{\"disposition\":" + json_string(value.disposition)
    + ",\"clear_preference\":" + (value.clear_preference ? "true" : "false")
    + ",\"has_tradeoff\":" + (value.has_tradeoff ? "true" : "false")
    + ",\"evidence_sufficient\":" + (value.evidence_sufficient ? "true" : "false")
    + ",\"summary\":" + json_string(value.summary)
    + ",\"recommendation\":" + json_string(value.recommendation)
    + ",\"rationale\":" + json_string(value.rationale)
    + ",\"basis\":" + json_strings(value.basis)
    + ",\"alternatives\":" + json_strings(value.alternatives) + "}"
}
fn resolve_decision(run: string, phase: string) {
  let prefix = "node tools/bugfix/run.mjs "
  let quoted = shell_path(run)
  let context = bash({ command: prefix + "decision-start " + quoted + " " + phase })?.trim()
  if !context.startsWith(run + "/decision-") || !context.endsWith("/context.json") || context.includes("\n") {
    return DecisionOutcome { proceed: false, feedback: "Decision snapshot failed: " + context, context_path: context }
  }
  let kind = bash({ command: prefix + "decision-kind " + quoted + " " + shell_path(context) })?.trim()
  if kind != "SPEC" && kind != "SCOPED" {
    return DecisionOutcome { proceed: false, feedback: "Invalid decision scope discriminator.", context_path: context }
  }
  let tree = worktree(run)?
  if tree == "" { return DecisionOutcome { proceed: false, feedback: "Invalid isolated worktree path", context_path: context } }
  let result = bugfix_decide(context) with { cwd: tree }
  let failure = match result { Ok(_) => "", Err(error) => error_reason(error) }
  if failure != "" {
    theta_print({ text: "Astra decision pass failed; no authorization granted: " + failure + "\nContext: " + context })?
    return DecisionOutcome { proceed: false, feedback: "Decision reviewer failed: " + failure, context_path: context }
  }
  let decision: DecisionRecord = result?
  write({ path: context + ".verdict.json", content: decision_json(decision) })?
  let disposition = bash({ command: prefix + "decision-record " + quoted + " " + shell_path(context) })?.trim()
  let feedback = "Read the recorded decision at " + context + " and decision-authorizations.md. "
    + "Apply only its exact scoped authority; all original evidence, stage boundaries and gates remain mandatory. "
    + decision.recommendation
  if disposition == "CONTINUE" {
    theta_print({ text: "ASTRA — continuing " + phase + ": " + decision.summary + "\nBasis and scope: " + context })?
    return DecisionOutcome { proceed: true, feedback: feedback, context_path: context }
  }
  theta_print({ text: "ASTRA — " + disposition + " at " + phase + ": " + decision.summary
    + "\nAstra recommends: " + decision.recommendation + "\nReasoning: " + decision.rationale
    + "\nBasis: " + decision.basis.join("; ") + "\nAlternatives: " + decision.alternatives.join("; ")
    + "\nExact context: " + context })?
  // The controller must record provisional scope before CONTINUE. Any other
  // response is not authority; never fall back to a mid-run approval dialog.
  DecisionOutcome { proceed: false, feedback: "No authorization: " + context, context_path: context }
}
// Up to three attempts per stage call. Every substantive blocked/decision
// outcome receives a fresh assessment before owner escalation, not a keyword heuristic.
fn run_stage(run: string, phase: string, feedback: string) {
  let mut attempt = 0
  let mut guidance = feedback
  while attempt < 3 {
    attempt += 1
    let result = stage_attempt(run, phase, guidance)?
    if result.status == "pass" || result.status == "needs_spec" { return result }
    let decision = resolve_decision(run, phase)?
    if !decision.proceed { return result }
    if attempt == 3 {
      return worker_failure("Automatic stage retry limit reached; inspect recorded decisions and unresolved stage obligations.")
    }
    guidance = feedback + "\n" + decision.feedback
  }
  worker_failure("Automatic stage retry limit reached.")
}
schema RankItem {
  id: string, severity: "critical" | "high" | "medium" | "low",
  provisional: boolean, reason: string
}
schema RankEdge { before: string, after: string, reason: string }
fn ranking_line(value: string): string {
  value.trim().replace("\r", " ").replace("\n", " ").replace("\t", " ")
}
fn ranking_stop(reason: string, artifacts: string): string {
  stop_report("(listing)", "Open-bug severity / fix-order assessment", reason,
    "Unknown — inspect the assessment failure; no fix was attempted.",
    "Not evaluated — ranking is triage, not reproduction.", "Not evaluated — no implementation started.",
    "No fix started or checkout lease acquired; incomplete rankings are not displayed.",
    "Resolve the reported issue and rerun /fix-bug.", "Use a fresh, complete assessment rather than stale or partial priorities.", artifacts)
}
fn ranked_list() {
  let catalog = bash({ command: "node tools/bugfix/run.mjs rank-start" })?.trim()
  if catalog == "EMPTY" { return "No open bugs." }
  if !catalog.startsWith("/") || !catalog.includes("/.pi/tmp/bugfix-ranking-") || !catalog.endsWith("/catalog.json") || catalog.includes("\n") {
    return ranking_stop("Could not prepare ranking input: " + catalog, ".pi/tmp/bugfix-ranking-*")
  }
  theta_print({ text: "Assessing current open bugs by severity and fix dependencies..." })?
  let assessment = bugfix_rank(catalog)?
  // Local array sinks keep iteration truthful across the imported-schema type
  // gap tracked by bug 0518. The worker's typed return validates the wire shape.
  let items: array<RankItem> = assessment.bugs
  let edges: array<RankEdge> = assessment.ordering
  let guidance: array<string> = assessment.guidance
  let mut wire = "RANK1\n"
  for item in items {
    wire += "BUG\t" + ranking_line(item.id) + "\t" + ranking_line(item.severity) + "\t"
      + (item.provisional ? "true" : "false") + "\t" + ranking_line(item.reason) + "\n"
  }
  for edge in edges {
    wire += "EDGE\t" + ranking_line(edge.before) + "\t" + ranking_line(edge.after) + "\t" + ranking_line(edge.reason) + "\n"
  }
  for note in guidance { wire += "GUIDE\t" + ranking_line(note) + "\n" }
  write({ path: catalog + ".ranking.tsv", content: wire })?
  let listing = bash({ command: "node tools/bugfix/run.mjs rank-render " + shell_path(catalog) })?
  if !listing.startsWith("OPEN BUGS — SEVERITY RANKING") { return ranking_stop(listing, catalog) }
  listing
}
// Keep application outcomes as values inside the workflow, then explicitly
// display the settled outcome below. Prompt-mode Ok return values are private
// programmatic results, not user-facing output (including "STOP: ...").
fn workflow(arguments: string) {
// A single defaultless string bypasses the model binder. Inventory and display
// are deterministic; no-argument severity/fix-order assessment uses a read-only worker.
let mut bug = ""
let mut ship = true
let mut review_rounds = 5
let mut resumed = false
let mut request_path = ""
if arguments.trim() != "" {
  // Allocate before writing: overlapping invocations must never share a handoff file.
  request_path = bash({ command: "node tools/bugfix/run.mjs request" })?.trim()
  write({ path: request_path, content: arguments })?
  let parsed = match bash({ command: "node tools/bugfix/run.mjs parse-file " + shell_path(request_path) }) {
    Ok(text) => text,
    Err(error) => "INVALID: " + error.message,
  }
  let fields = parsed.trim().split("\n")
  if fields.length != 4 || (fields[0] != "FIX" && fields[0] != "RESUME") {
    return stop_report("(not selected)", "Argument validation (before reproduction)",
      "Invalid arguments. " + parsed, "No — invalid command arguments.",
      "Unknown — no bug examined.", "Unknown — no fix attempted.",
      "No worker launched or fix applied.",
      "Use /fix-bug NUMBER or /fix-bug resume [NUMBER], with optional ship/review_rounds.",
      "Correct the arguments and retry.", "No run directory created.")
  }
  resumed = fields[0] == "RESUME"
  bug = fields[1]
  ship = fields[2] == "true"
  if !resumed {
    review_rounds = 0
    for value in ["1", "2", "3", "4", "5"] {
      review_rounds += 1
      if value == fields[3] { break }
    }
  }
}
if bug.trim() == "" && !resumed {
  let listing = match ranked_list() {
    Ok(value) => value,
    Err(error) => ranking_stop(error_reason(error), ".pi/tmp/bugfix-ranking-*"),
  }
  return listing
}
if review_rounds < 1 || review_rounds > 5 {
  return checkpoint_stop(bug, "Argument validation", "review_rounds must be between 1 and 5",
    "Choose a review_rounds value from 1 to 5.", "Correct the arguments and retry.", "No run directory created.")
}
// Pass the untrusted slash argument through a file, never shell interpolation.
let initial: string = match bash({ command: resumed
  ? "node tools/bugfix/run.mjs resume-file " + shell_path(request_path) + " \"$PPID\""
  : "node tools/bugfix/run.mjs start-file " + shell_path(request_path) + " \"$PPID\"" }) {
  Ok(text) => text,
  Err(error) => error.message,
}
let run = initial.trim()
if !run.startsWith("/") || !run.includes("/.pi/tmp/fix-bug-") || run.includes("\n") || run.includes("BLOCKED:") {
  return checkpoint_stop(bug.trim() == "" ? "(lease owner)" : bug,
    resumed ? "Resume validation (before continuation)" : "Checkout preflight (before reproduction)", initial,
    "Resolve the reported preflight condition without discarding existing work.",
    "Preserve local changes; if a prior run owns the checkout, inspect its handoff before starting another run.",
    "No new run initialized; inspect .pi/tmp/fix-bug.lock/owner.json if present.")
}
let prefix = "node tools/bugfix/run.mjs "
let quoted = shell_path(run)
let info_text = match bash({ command: prefix + "info " + quoted }) {
  Ok(text) => text,
  Err(error) => "INFO_ERROR: " + error.message,
}
let info = info_text.trim().split("\n")
if info.length != 3 {
  let paused = control(prefix + "pause " + quoted)
  return checkpoint_stop(bug, "Saved run settings", "Could not read saved bug/options.", "Inspect state.json and the active marker.", "Reconcile the saved run rather than starting over.", run)
}
bug = info[0]
ship = info[1] == "true"
review_rounds = 0
for value in ["1", "2", "3", "4", "5"] {
  review_rounds += 1
  if value == info[2] { break }
}
theta_print({ text: "Bug " + bug + (resumed ? ": resuming recorded checkpoints. Artifacts: " : ": reproduction started. Artifacts: ") + run })?
// Revised contracts replan in this invocation instead of forcing an owner resume.
// The ceiling bounds all automatic replan/repair cycles; it never waives a gate.
let mut outcome = "REPLAN"
let mut cycle = 0
while outcome == "REPLAN" && cycle < 3 {
  cycle += 1
  outcome = match drive(run, bug, ship, review_rounds) {
    Ok(value) => value,
    Err(error) => checkpoint_stop(bug, "Workflow execution", error_reason(error),
      "Inspect the latest stage report and checkout.", "Preserve partial work; use /fix-bug resume only after resolving the stop reason.", run),
  }
}
if outcome == "REPLAN" {
  outcome = checkpoint_stop(bug, "Automatic continuation limit", "Three workflow cycles did not reach verified completion.",
    "Inspect the recorded decisions and unresolved findings before resuming.",
    "Keep the partial fix and original evidence; do not remove limits or waive verification.", run)
}
if !control(prefix + "pause " + quoted) {
  return checkpoint_stop(bug, "Execution handoff", "Could not clear the active-run marker. " + outcome,
    "Confirm the workflow stopped before manually pausing its marker.", "Do not start a concurrent resume.", run)
}
outcome
}
fn drive(run: string, bug: string, ship: boolean, review_rounds: integer) {
let prefix = "node tools/bugfix/run.mjs "
let quoted = shell_path(run)
let tree = worktree(run)?
if tree == "" { return checkpoint_stop(bug, "Worker checkout", "Invalid isolated worktree path.",
  "Inspect state.json.", "Do not run workers in the original checkout.", run) }
let reproduce = match run_stage(run, "reproduce", "") {
  Ok(value) => value,
  Err(error) => worker_failure(error_reason(error)),
}
if reproduce.status != "pass" {
  return stop_report(bug, "Reproduction", reproduce.summary, reproduce.environment,
    reproduce.bug_validity, reproduce.fixability, reproduce.progress,
    reproduce.next_action, reproduce.recommendation, run)
}
let diagnosis = match run_stage(run, "diagnose", "") {
  Ok(value) => value,
  Err(error) => worker_failure(error_reason(error)),
}
if diagnosis.status != "pass" {
  return stop_report(bug, "Diagnosis", diagnosis.summary, diagnosis.environment,
    diagnosis.bug_validity, diagnosis.fixability, diagnosis.progress,
    diagnosis.next_action, diagnosis.recommendation, run)
}
if !control(prefix + "red " + quoted) { return checkpoint_stop(bug, "Pre-fix evidence gate", "Red witness evidence gate failed.",
  "Inspect red-*.json for the failing command and assertion signature.", "Establish a correct-reason red before implementing; do not waive the evidence gate.", run) }
if !control(prefix + "snapshot " + quoted) { return checkpoint_stop(bug, "Plan snapshot", "Plan snapshot failed.",
  "Check HEAD, branch, scope and specification approval against state.json.", "Resolve checkout drift before planning; preserve existing work.", run) }
let plan = match run_stage(run, "plan", "") {
  Ok(value) => value,
  Err(error) => worker_failure(error_reason(error)),
}
if !control(prefix + "review-check " + quoted) { return checkpoint_stop(bug, "Planning — read-only check", "Plan changed checkout files or checkpoint validation failed.",
  "Compare the checkout with the saved snapshot.", "Review unexpected changes before authorizing implementation.", run) }
if plan.status != "pass" && plan.status != "needs_spec" {
  return stop_report(bug, "Planning (before implementation)", plan.summary, plan.environment,
    plan.bug_validity, plan.fixability, plan.progress, plan.next_action, plan.recommendation, run)
}
if !control(prefix + "snapshot " + quoted) { return checkpoint_stop(bug, "Evidence review snapshot", "Evidence snapshot failed.",
  "Check checkout drift and approval against state.json.", "Resolve the snapshot failure before independent review.", run) }
let evidence_result = bugfix_review(run, "evidence") with { cwd: tree }
let evidence_error = match evidence_result { Ok(_) => "", Err(error) => error_reason(error) }
if evidence_error != "" { return checkpoint_stop(bug, "Evidence/plan review — worker execution", evidence_error,
  "Inspect the reviewer failure and preserve the existing evidence/plan.", "Resolve the reviewer failure before implementation; it is not a verdict on bug validity.", run) }
let evidence = evidence_result?
if !control(prefix + "review-check " + quoted) { return checkpoint_stop(bug, "Evidence review — read-only check", "Evidence reviewer changed files or checkpoint validation failed.",
  "Compare the checkout with the saved snapshot.", "Review unexpected changes; do not accept a compromised read-only review.", run) }
write({ path: run + "/evidence-review.md", content: evidence.findings })?
write({ path: run + "/evidence-review-result.json", content: "{\"ok\":" + (evidence.ok ? "true" : "false") + ",\"findings\":" + json_string(evidence.findings) + "}" })?
if !evidence.ok {
  let decision = resolve_decision(run, "evidence")?
  // Never convert a failed review to a pass or reuse its rejected cached plan.
  // Archive/invalidate the old plan explicitly; the next PLAN gets the findings
  // and scoped decision, followed by a genuinely fresh evidence review.
  if decision.proceed {
    let feedback_path = run + "/evidence-replan-feedback.md"
    write({ path: feedback_path, content: evidence.findings + "\n\n" + decision.feedback })?
    if !control(prefix + "replan " + quoted + " " + shell_path(feedback_path)) {
      return checkpoint_stop(bug, "Evidence-review plan revision", "Could not archive and invalidate the rejected plan.",
        "Inspect the recorded decision and replan transition; do not overwrite completed reports manually.",
        "Require an explicit plan revision and fresh independent evidence review.", run)
    }
    return "REPLAN"
  }
  return checkpoint_stop(bug, "Evidence/plan review (before implementation)", "Independent evidence/plan review did not pass.",
    "Address the blocking findings in evidence-review.md.", "Repair the evidence or plan before implementation; do not treat this review failure as proof the bug is invalid.", run)
}
if !control(prefix + "evidence-review-record " + quoted) {
  return checkpoint_stop(bug, "Evidence review — durable verification", "Could not bind clean evidence review to the current plan and checkout.",
    "Inspect evidence-review-result.json and checkpoint drift.", "Do not infer authorization from a stale review report.", run)
}
if plan.status == "needs_spec" && !control(prefix + "approved " + quoted) {
  let decision = resolve_decision(run, "plan")?
  if !decision.proceed || !control(prefix + "approved " + quoted) {
    return stop_report(bug, "Specification decision (before continuing implementation)",
      "Exact specification proposal is not authorized; see the recorded Astra assessment.", "Not established — authorization is a separate checkpoint.",
      "See reproduction and evidence-review.md; authorization does not determine validity.", "Pending an authorized contract; not shown to be unfixable.",
      "Earlier partial work, if any, is retained. No further implementation is authorized under this proposal.",
      "Resolve the recorded tradeoff or objective prerequisite; then use /fix-bug resume.",
      "Do not implement an unauthorized contract or treat missing UI as consent.", run)
  }
}
let implemented = match run_stage(run, "implement", "") {
  Ok(value) => value,
  Err(error) => worker_failure(error_reason(error)),
}
if implemented.status == "needs_spec" { return "REPLAN" }
if implemented.status != "pass" {
  return stop_report(bug, "Implementation / worker verification (before independent fix review)",
    implemented.summary, implemented.environment, implemented.bug_validity,
    implemented.fixability, implemented.progress, implemented.next_action, implemented.recommendation, run)
}
if !control(prefix + "gate " + quoted + " initial") { return checkpoint_stop(bug, "Initial verification (before independent fix review)", "Initial verification gate failed.",
  "Find the failed command in green-*.json or gate-*-initial-*.json and resolve its cause.", "Keep the local fix; require green gates before review, without weakening assertions.", run) }
let mut clean = false
let mut round = 0
let mut reviews: array<string> = []
while round < review_rounds {
  round += 1
  if !control(prefix + "snapshot " + quoted) { return checkpoint_stop(bug, "Independent fix review — snapshot", "Review snapshot failed.",
    "Check checkout drift and approval against state.json.", "Resolve the snapshot failure before review.", run) }
  let review_result = bugfix_review(run, "fix") with { cwd: tree }
  let review_error = match review_result { Ok(_) => "", Err(error) => error_reason(error) }
  if review_error != "" { return checkpoint_stop(bug, "Independent fix review — worker execution", review_error,
    "Inspect the reviewer failure; retain the current fix and prior review evidence.", "Resolve the reviewer failure before proceeding; do not repair code based on a missing review.", run) }
  let review = review_result?
  if !control(prefix + "review-check " + quoted) { return checkpoint_stop(bug, "Independent fix review — read-only check", "Reviewer changed files or checkpoint validation failed.",
    "Compare the checkout with the saved snapshot.", "Review unexpected changes; do not accept a compromised read-only review.", run) }
  reviews = reviews.concat([review.findings])
  write({ path: run + "/reviews.md", content: reviews.join("\n\n--- next review ---\n\n") })?
  if review.ok {
    clean = true
    break
  }
  if round >= review_rounds { break }
  let repair = match run_stage(run, "repair", review.findings) {
    Ok(value) => value,
    Err(error) => worker_failure(error_reason(error)),
  }
  if repair.status == "needs_spec" { return "REPLAN" }
  if repair.status != "pass" {
    return stop_report(bug, "Review repair / worker verification", repair.summary, repair.environment,
      repair.bug_validity, repair.fixability, repair.progress, repair.next_action, repair.recommendation, run)
  }
  if !control(prefix + "gate " + quoted + " repair") { return checkpoint_stop(bug, "Repair verification", "Repair verification gate failed.",
    "Find the failed command in green-*.json or gate-*-repair-*.json and resolve its cause.", "Reverify the repair before another review; do not waive gates.", run) }
}
if !clean {
  return checkpoint_stop(bug, "Independent fix review — round limit", "Review budget exhausted with unresolved blocking findings.",
    "Resolve the remaining findings in reviews.md before another verification/review pass.", "Keep the fix local; do not ship with unresolved must-fix findings.", run)
}
let closed = match run_stage(run, "close", "Independent fix review is clean - prepare factual closure record, no release claims.") {
  Ok(value) => value,
  Err(error) => worker_failure(error_reason(error)),
}
if closed.status != "pass" {
  return stop_report(bug, "Closure record (before final verification)", closed.summary, closed.environment,
    closed.bug_validity, closed.fixability, closed.progress, closed.next_action, closed.recommendation, run)
}
if !control(prefix + "gate " + quoted + " final") { return checkpoint_stop(bug, "Final verification", "Final verification gate failed.",
  "Find the failed command in green-*.json or gate-*-final-*.json and resolve its cause.", "Do not ship until the final diff passes verification.", run) }
if !control(prefix + "snapshot " + quoted) { return checkpoint_stop(bug, "Final review snapshot", "Final snapshot failed.",
  "Check checkout drift and approval against state.json.", "Resolve the snapshot failure before final review.", run) }
let final_result = bugfix_review(run, "final") with { cwd: tree }
let final_error = match final_result { Ok(_) => "", Err(error) => error_reason(error) }
if final_error != "" { return checkpoint_stop(bug, "Final verification review — worker execution", final_error,
  "Inspect the reviewer failure; do not assume final approval.", "Obtain a completed final review before shipment.", run) }
let final_review = final_result?
if !control(prefix + "review-check " + quoted) { return checkpoint_stop(bug, "Final review — read-only check", "Final reviewer changed files or checkpoint validation failed.",
  "Compare the checkout with the saved snapshot.", "Review unexpected changes before shipment.", run) }
write({ path: run + "/final-review.md", content: final_review.findings })?
if !final_review.ok {
  let decision = resolve_decision(run, "final")?
  if decision.proceed {
    let repair = run_stage(run, "repair", final_review.findings + "\n" + decision.feedback)?
    if repair.status == "pass" || repair.status == "needs_spec" { return "REPLAN" }
    return stop_report(bug, "Final-review repair", repair.summary, repair.environment,
      repair.bug_validity, repair.fixability, repair.progress, repair.next_action, repair.recommendation, run)
  }
  return checkpoint_stop(bug, "Final verification review", "Final independent review did not pass.",
    "Address the blocking findings in final-review.md and reverify the changed diff.", "Keep the fix local until the final review is clean.", run)
}
write({ path: run + "/final-review-result.json", content: "{\"ok\":true,\"findings\":" + json_string(final_review.findings) + "}" })?
if !control(prefix + "final-review-record " + quoted) {
  return checkpoint_stop(bug, "Final review — durable verification", "Could not bind clean final review to the verified checkout.",
    "Inspect final-review-result.json and post-gate drift before continuing.", "Do not ship or waive final review integrity.", run)
}
// Only now, after clean final review bound to fresh green gates, surface owner
// choices. A non-CLEAR response fails closed and preserves the resumable worktree.
let approvals = bash({ command: prefix + "approval-report " + quoted })?.trim()
if approvals != "CLEAR" {
  if !approvals.startsWith("PENDING OWNER APPROVAL — shipment blocked") {
    return checkpoint_stop(bug, "Deferred approval integrity", approvals,
      "Inspect decision records and approval-report failure.", "Do not infer approval clearance or ship on an invalid report.", run)
  }
  return "VERIFIED — OWNER APPROVAL REQUIRED; NOT MERGED OR PUSHED\n" + approvals
    + "\nAll reviews and gates passed. Branch and worktree retained; no decision is approved by silence.\nWorktree: " + tree + "\nReports: " + run
}
if !ship {
  if !control(prefix + "release " + quoted) { return checkpoint_stop(bug, "Local handoff — lease release", "Checkout lease release failed after verification.",
    "Inspect .pi/tmp/fix-bug.lock/owner.json before releasing the stopped run's lease.", "Preserve the verified local fix; do not start an overlapping run.", run) }
  return "VERIFIED, NOT SHIPPED: branch and worktree retained; inspect state.json and reports in " + run + ". No commit, merge, push, tag or package publication performed."
}
theta_print({ text: "VERIFIED — committing bug " + bug + ", merging to main and pushing under standing owner permission.\nFor pi-theta, also update and push pi-config's dependency pin to the new HEAD.\nNo version bump, tag or npm publication. Reports: " + run + "\n" + final_review.findings })?
if !control(prefix + "ship " + quoted) { return stop_report(bug, "Shipment / commit / push",
  "Automatic commit/push failed or shipment guards refused it.", "Unknown — inspect shipment evidence.",
  "Confirmed by the reviewed evidence.", "Fix verified; shipment state is a separate question.",
  "Final verification/review passed. A commit or push MAY have occurred; do not assume either outcome.",
  "Inspect shipment.json if present and git status/log before retrying.",
  "Establish commit/push state before any retry; never force push or restart blindly.", run) }
"MERGED TO MAIN AND PUSHED (including pi-config dependency update for pi-theta); temporary branch/worktree cleaned up - reports and SHAs in " + run + "/shipment.json"
}

// One deterministic completion surface for EVERY normal terminal branch:
// blocked stages, refused gates/approval, local verification, and shipment.
// Stage-worker Err outcomes are handled at their known phase above. Unexpected
// setup/review/tool errors still get an honest card instead of a bare runtime Err.
let summary = match workflow(arguments) {
  Ok(value) => value,
  Err(error) => checkpoint_stop("(see request)", "Workflow tool/query execution (exact checkpoint unavailable)",
    error.message, "Inspect the latest run reports and runtime error before continuing.",
    "Preserve partial work; do not infer bug validity or shipment state from a tool error.", ".pi/tmp/fix-bug-* (latest run, if initialized)"),
}
theta_print({ text: summary })?
summary
