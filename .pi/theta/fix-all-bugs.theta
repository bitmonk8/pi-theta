---
description: Attempt all open bugs safely in four lanes with retained-work resume and sequential integration
mode: prompt
tools:
  - bash
  - read
  - write
  - theta_print
  - ./workers/bugfix-batch-plan.theta
  - ./workers/bugfix-batch-lane.theta
  - ./workers/bugfix-batch-merge.theta
  - ./workers/bugfix-batch-review.theta
params:
  arguments: string
---
schema BatchBug {
  id: string, ready: boolean, reason: string,
  dependencies: array<string>, files: array<string>
}
fn quote(value: string): string { "'" + value.replace("'", "'\\''") + "'" }
fn json_text(value: string): string {
  "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"")
    .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + "\""
}
fn json_list(values: array<string>): string {
  let mut text = ""
  for value in values {
    if text != "" { text += "," }
    text += json_text(value)
  }
  "[" + text + "]"
}
fn error_reason(error: QueryError): string {
  if error.kind == "invoke_callee" { return error.inner.message }
  error.message
}
fn control(command: string): string {
  // Setup can bootstrap dependencies and promotion can update the consumer.
  // These are not all quick queries; never impose a one/two-minute host cap.
  let output = match bash({ command: command, timeout: 3660 }) { Ok(text) => text, Err(error) => error.message }
  output.trim()
}
fn integration_gate(command: string): string {
  // Controller: 3600s aggregate, 1800s/command, <=5s cleanup. The outer
  // deadline must leave headroom; model turns do not own this gate execution.
  let output = match bash({ command: command, timeout: 3660 }) { Ok(text) => text, Err(error) => error.message }
  output.trim()
}
fn save_verdict(path: string, ok: boolean, findings: string): string {
  match write({ path: path, content: "{\"ok\":" + (ok ? "true" : "false")
    + ",\"findings\":" + json_text(findings) + "}" }) {
    Ok(_) => "PASS", Err(error) => error.message,
  }
}
fn run_json(path: string, run: string): boolean {
  path.startsWith(run + "/") && path.endsWith(".json") && !path.includes("\n")
    && !path.includes("\r") && !path.includes("/../") && !path.includes("/./")
}
fn bug_id(id: string): boolean {
  id.length == 4 && id.replace("0", "").replace("1", "").replace("2", "")
    .replace("3", "").replace("4", "").replace("5", "").replace("6", "")
    .replace("7", "").replace("8", "").replace("9", "") == ""
}
fn park(run: string, id: string, reason: string) {
  let parked = control("node tools/bugfix/batch.mjs integration-park " + quote(run) + " " + quote(id))
  if parked != "PARKED" {
    return "BATCH STOP — cannot prove integration safe to park for bug " + id
      + ". Shipment/worker state may be uncertain; retain locks and all evidence.\n" + reason + "\n" + parked
  }
  theta_print({ text: "Bug " + id + " integration parked before push; independent bugs continue. Details: " + run })?
  "PARKED"
}
fn integrate(run: string, id: string) {
  let prefix = "node tools/bugfix/batch.mjs "
  let args = quote(run) + " " + quote(id)
  let context = control(prefix + "integration-start " + args)
  if !run_json(context, run) { return park(run, id, "Integration setup failed: " + context)? }
  let path = control(prefix + "integration-verdict-path " + args)
  if !run_json(path, run) || !path.endsWith("/verdict.json") {
    return park(run, id, "Invalid registered per-attempt verdict path: " + path)?
  }
  // Derive ONLY from the registered canonical basename, never replace arbitrary
  // occurrences in a run/context path. Successful preparation is not authority.
  let prepare_path = path.split("/").slice(0, -1).join("/") + "/prepare-verdict.json"
  theta_print({ text: "Astra is preparing bug " + id + " sequentially; a deterministic gate and fresh independent review follow." })?
  let entered = control(prefix + "integration-enter " + args)
  if entered != "PASS" { return park(run, id, "Could not enter merge worker: " + entered)? }
  let merged = bugfix_batch_merge(context)
  let failure = match merged { Ok(_) => "", Err(error) => error_reason(error) }
  if failure != "" {
    // An invoke Err is NOT proof that the child/its commands are dead. Do not
    // forge a negative verdict, mark settled, park, or let another job ship.
    return "BATCH STOP — integration worker did not return a typed verdict for bug " + id
      + "; liveness is uncertain. Integration marker and lease retained.\n" + failure
  }
  let preparation = merged?
  // Preserve the actual typed return BEFORE fallible settlement. Negative
  // preparation is also a final refusal, but successful preparation is not.
  let prepared = save_verdict(prepare_path, preparation.ok, preparation.findings)
  if prepared != "PASS" {
    return "BATCH STOP — could not save preparation verdict; integration marker retained.\n" + preparation.findings + "\n" + prepared
  }
  if !preparation.ok {
    let refused = save_verdict(path, preparation.ok, preparation.findings)
    if refused != "PASS" { return "BATCH STOP — could not save final refusal; marker retained.\n" + preparation.findings + "\n" + refused }
  }
  let settled = control(prefix + "integration-settled " + args)
  if settled != "PASS" {
    return "BATCH STOP — could not record preparation worker settlement; marker and verdict retained.\n" + preparation.findings + "\n" + settled
  }
  if !preparation.ok { return park(run, id, "Preparation declined: " + preparation.findings)? }

  // No model worker is active during the exact controller-owned merged gate.
  let gated = integration_gate(prefix + "integration-gate " + args)
  if gated != "PASS" {
    let refused = save_verdict(path, false, "Integration gate failed: " + gated)
    if refused != "PASS" { return "BATCH STOP — gate failed and final refusal could not be saved.\n" + gated + "\n" + refused }
    return park(run, id, "Integration gate failed: " + gated)?
  }
  let review_started = control(prefix + "integration-review-start " + args)
  if review_started != "PASS" { return park(run, id, "Could not bind independent review to the gate: " + review_started)? }
  let reviewing = control(prefix + "integration-enter " + args)
  if reviewing != "PASS" { return park(run, id, "Could not enter independent reviewer: " + reviewing)? }
  let reviewed = bugfix_batch_review(context)
  let review_failure = match reviewed { Ok(_) => "", Err(error) => error_reason(error) }
  if review_failure != "" {
    return "BATCH STOP — independent reviewer did not return a typed verdict for bug " + id
      + "; liveness is uncertain. Integration marker, preparation and gate retained.\n" + review_failure
  }
  let verdict = reviewed?
  let saved = save_verdict(path, verdict.ok, verdict.findings)
  if saved != "PASS" { return "BATCH STOP — could not save independent review verdict; marker retained.\n" + verdict.findings + "\n" + saved }
  let review_settled = control(prefix + "integration-settled " + args)
  if review_settled != "PASS" {
    return "BATCH STOP — could not record independent reviewer settlement; marker and verdict retained.\n" + verdict.findings + "\n" + review_settled
  }
  let review_recorded = control(prefix + "integration-review-record " + args)
  if review_recorded != "PASS" { return park(run, id, "Independent review binding failed: " + review_recorded)? }
  let recorded = control(prefix + "integrate-record " + args)
  if recorded != "PASS" { return park(run, id, recorded)? }
  "PASS"
}
fn execute(arguments: string) {
  let request = arguments.trim()
  if request != "" && request != "resume" { return "Usage: /fix-all-bugs [resume]. No raw controller arguments are accepted." }
  let prefix = "node tools/bugfix/batch.mjs "
  let run = control(prefix + (request == "resume" ? "resume" : "start"))
  if !run.startsWith("/") || !run.includes("/.pi/tmp/fix-all-bugs-") || run.includes("\n") {
    return "BATCH STOP — could not acquire/reconcile batch: " + run
  }
  // finish never clears uncertain integration markers or live source jobs. A
  // released lease does not imply scheduling completed (e.g. planner failure).
  let result = match coordinate(run) {
    Ok(text) => text,
    Err(error) => "BATCH STOP — " + error_reason(error) + "\nInspect retained work and reports: " + run,
  }
  let finished = control(prefix + "finish " + quote(run))
  let handoff = finished == "PASS" ? "" : "\nBatch lease retained; inspect active jobs/integration before resuming.\n" + finished
  let audit = control(prefix + "render-report " + quote(run))
  result + handoff + "\n" + audit
}
fn coordinate(run: string) {
  let prefix = "node tools/bugfix/batch.mjs "
  let quoted = quote(run)
  let accepted = control(prefix + "plan-status " + quoted)
  if accepted == "NEEDS_PLAN" {
    let catalog = control(prefix + "catalog " + quoted)
    if catalog == "EMPTY" {
      // Accept an explicit empty plan without invoking a model. next still owns
      // the durable terminal scheduling observation, including on resume.
      write({ path: run + "/plan.json", content: "{\"bugs\":[],\"guidance\":[]}" })?
      let planned = control(prefix + "plan " + quoted)
      if planned != "PASS" { return "BATCH STOP — empty inventory plan validation failed: " + planned }
    } else {
      if !run_json(catalog, run) || !catalog.endsWith("/catalog.json") {
        return "BATCH STOP — invalid catalog: " + catalog + "\nReports: " + run
      }
      theta_print({ text: "Assessing every open bug: safe attempts, genuine owner choices and external prerequisites. Reports: " + run })?
      let assessment = bugfix_batch_plan(catalog)?
      let bugs: array<BatchBug> = assessment.bugs
      let guidance: array<string> = assessment.guidance
      let mut wire = ""
      for bug in bugs {
        if wire != "" { wire += "," }
        wire += "{\"id\":" + json_text(bug.id) + ",\"ready\":" + (bug.ready ? "true" : "false")
          + ",\"reason\":" + json_text(bug.reason) + ",\"dependencies\":" + json_list(bug.dependencies)
          + ",\"files\":" + json_list(bug.files) + "}"
      }
      write({ path: run + "/plan.json", content: "{\"bugs\":[" + wire + "],\"guidance\":" + json_list(guidance) + "}" })?
      let planned = control(prefix + "plan " + quoted)
      if planned != "PASS" { return "BATCH STOP — readiness/dependency plan validation failed: " + planned + "\nReports: " + run }
    }
  } else if accepted != "ACCEPTED" {
    return "BATCH STOP — cannot validate retained plan: " + accepted + "\nReports: " + run
  }
  let mut wave = 0
  // At most 1000 one-bug waves plus the durable terminal DONE observation.
  while wave < 1001 {
    wave += 1
    // Always drain retained VERIFIED sources BEFORE starting any new lanes.
    // This also integrates the previous settled wave in deterministic order.
    let ready = control(prefix + "ready " + quoted)
    if ready != "NONE" {
      let ids: array<string> = ready.split("\n")
      for id in ids {
        if !bug_id(id) { return "BATCH STOP — invalid verified job id: " + id }
        let integrated = integrate(run, id)?
        if integrated != "PASS" && integrated != "PARKED" { return integrated + "\nReports: " + run }
      }
    }
    let next = control(prefix + "next " + quoted)
    if next == "DONE" { return "Batch scheduling complete; all bugs have a recorded disposition." }
    let manifests: array<string> = next.split("\n")
    if manifests.length < 1 || manifests.length > 4 { return "BATCH STOP — invalid four-lane schedule. Reports: " + run }
    for manifest in manifests {
      if !run_json(manifest, run) || !manifest.startsWith(run + "/jobs/") {
        return "BATCH STOP — invalid job manifest: " + manifest + "\nReports: " + run
      }
    }
    theta_print({ text: "Starting/resuming a dependency-safe wave of up to four isolated /fix-bug lanes. Reports: " + run })?
    let results = par for manifest in manifests max 4 { bugfix_batch_lane(manifest)? }
    for result in results {
      let note = match result { Ok(_) => "Lane settled; validating its recorded evidence.", Err(error) => "Lane failed: " + error.message }
      theta_print({ text: note })?
    }
    // Every sibling has settled before collection or any integration.
    for manifest in manifests {
      let id = manifest.split("/").slice(-1).join("").replace(".json", "")
      let collected = control(prefix + "collect " + quoted + " " + quote(id))
      if collected != "VERIFIED" && collected != "BLOCKED" && collected != "PENDING" {
        return "BATCH STOP — invalid lane evidence for " + id + ": " + collected + "\nReports: " + run
      }
    }
  }
  "BATCH STOP — wave limit reached; all remaining work retained. Reports: " + run
}
let report = match execute(arguments) {
  Ok(text) => text,
  Err(error) => "BATCH STOP — " + error_reason(error) + ". Inspect .pi/tmp/fix-all-bugs-* and its lease before retrying.",
}
theta_print({ text: report })?
report
