---
description: "Ralph-style quality loop - review changed pi-theta sources lens-by-lens (roster in `lenses`; worker-backed today: D2, D7, D9), triage, fix confirmed findings in parallel git worktrees behind the offline gate, integrate, repeat until the open backlog is empty (state under quality/)"
argument-hint: "[max_cycles] [lenses] [shard_loc] [review_cap] [budget] [parallel] [push true/false]"
mode: prompt
bind_model: "anthropic/claude-sonnet-5"
tools:
  - bash
  - ./workers/lens-d2-cruft.theta
  - ./workers/lens-d7-testquality.theta
  - ./workers/lens-d9-placement.theta
  - ./workers/triage-finding.theta
  - ./workers/fix-cluster-tree.theta
params:
  max_cycles: integer = 3
  lenses: string = "D2,D7"
  shard_loc: string = "0"
  review_cap: string = "0"
  budget: integer = 10
  parallel: integer = 4
  push: boolean = true
  gate_cmd: string = "npx tsc --noEmit && npm test"
  cluster_max: string = "12"
  tree_workers: string = "6"
---
// cluster_max and tree_workers are string-typed because they are spliced into
// shell commands: cluster_max caps one manifest's issue count (an oversized
// cluster splits into <key>__p1, __p2, ...), tree_workers caps ONE worktree's
// vitest width so parallel x tree_workers stays inside the core budget
// (default 4 x 6 = 24 on a 32-core host).
import { ReviewSummary, TriageVerdict, TreeFixReport, lines } from "./workers/quality.thetalib"

// Convention used throughout: branch on COUNTS (wc -l), never on empty output.
// The host bash tool renders empty stdout as a placeholder string, so a
// raw-emptiness check like trim() == "" misfires on clean/empty results.

/// Provision one detached worktree for a cluster, OUTSIDE the repo root (under
/// $TEMP, forward-slashed so the path is usable as a child `cwd`), and give it
/// a node_modules so the in-tree gate can run: a Windows directory junction
/// where cygpath exists, a symlink otherwise. Copying node_modules per tree
/// would cost minutes per wave. Prints the tree path, or PROVISION_FAIL.
fn provision_cmd(wave: string, safe_key: string): string {
  return "set -e; base=$(cygpath -m \"$TEMP\" 2>/dev/null || printf %s \"${TMPDIR:-/tmp}\"); tree=\"$base/qfix-" + wave + "-" + safe_key + "\"; rm -rf \"$tree\"; git worktree add --detach \"$tree\" HEAD >/dev/null 2>&1 || { echo PROVISION_FAIL; exit 0; }; if command -v cygpath >/dev/null 2>&1; then MSYS_NO_PATHCONV=1 cmd /c mklink /J \"$(cygpath -w \"$tree/node_modules\")\" \"$(cygpath -w \"$PWD/node_modules\")\" >/dev/null 2>&1 || { echo PROVISION_FAIL; exit 0; }; else ln -s \"$PWD/node_modules\" \"$tree/node_modules\" || { echo PROVISION_FAIL; exit 0; }; fi; echo \"$tree\""
}

/// Remove every qfix-* worktree (this loop's trees only - a sibling worktree
/// of this repo is never touched). Run at wave START (reclaims anything a
/// halted run leaked) and again at wave end, including on the halt paths.
/// SAFETY: the shared node_modules link is unlinked FIRST and the directory is
/// left standing if that fails - a recursive delete that followed a junction
/// would take the main tree's node_modules with it.
fn sweep_cmd(): string {
  return "git worktree prune; git worktree list --porcelain | sed -n 's/^worktree //p' | grep -F /qfix- | while read -r t; do if command -v cygpath >/dev/null 2>&1; then MSYS_NO_PATHCONV=1 cmd /c rmdir \"$(cygpath -w \"$t/node_modules\")\" >/dev/null 2>&1; else rm -f \"$t/node_modules\"; fi; if [ -e \"$t/node_modules\" ]; then echo \"SWEEP_SKIP $t\"; else git worktree remove --force \"$t\" >/dev/null 2>&1; rm -rf \"$t\"; fi; done; git worktree prune; true"
}

/// One cluster picked for this wave. `manifest_rel` is what store.mjs takes
/// (it resolves against the repo root); `manifest_abs` is what the worktree
/// worker copies in, because quality/tmp/ is gitignored and therefore absent
/// from the tree's HEAD checkout.
schema Pick {
  key: string,
  manifest_rel: string,
  manifest_abs: string,
  tree: string
}

/// Cherry-pick one lane commit onto the integrated head. On conflict the
/// unmerged paths are printed BEFORE the abort (they become the retry's seed
/// guidance), then the CP_FAIL marker.
fn cherry_pick_cmd(sha: string): string {
  return "git cherry-pick " + sha + " >/dev/null 2>&1 && echo CP_OK || { git diff --name-only --diff-filter=U; git cherry-pick --abort >/dev/null 2>&1; echo CP_FAIL; }"
}

/// The unmerged paths a failed cherry_pick_cmd printed, comma-joined (every
/// line but the CP_FAIL marker).
fn conflicted_paths(cp: string): string {
  let mut raw: array<string> = []
  raw = lines(cp)
  let mut paths: array<string> = []
  for l in raw {
    if !l.includes("CP_FAIL") {
      paths = paths.concat([l])
    }
  }
  return paths.length == 0 ? "(unmerged paths unavailable)" : paths.join(", ")
}

/// A cluster whose worktree went green: one commit to cherry-pick.
/// `manifest_abs` is kept so a conflicted lane can be re-run in a fresh tree.
schema Green {
  key: string,
  manifest_rel: string,
  manifest_abs: string,
  sha: string,
  fixed: string
}

/// A green lane whose commit conflicted at integration: re-run once on the
/// integrated head, with the unmerged paths spelled out.
schema Retry {
  key: string,
  manifest_rel: string,
  manifest_abs: string,
  sha: string,
  conflicts: string
}

// ---------------------------------------------------------------- preflight
// The loop needs clean revert boundaries (a failed batch is undone with
// git reset) and a green baseline (otherwise gate failures cannot be
// attributed to fixes). Refuse loudly rather than improvise.
let dirty_n = bash({ command: "git status --porcelain | wc -l" })?
if dirty_n.trim() != "0" {
  let dirty = bash({ command: "git status --porcelain | head -20" })?
  let _ = @`Tell the user: /quality-loop refused to start — the working tree is not clean, and the loop needs clean revert boundaries. Commit or stash first. git status --porcelain reports:
${dirty}`?
  return "refused: dirty worktree"
}

// Lens-roster refusal: a config error refuses in seconds, before the
// (expensive) baseline gate. A lens id must have BOTH a surfaces.json entry
// AND a worker dispatch arm below (worker-backed today: D2, D7, D9).
let mut lens_list: array<string> = []
lens_list = lines(lenses.replace(",", "\n"))
let lenses_out = bash({ command: "node tools/quality/store.mjs lenses" })?
let mut configured: array<string> = []
configured = lines(lenses_out)
let mut bad_lens = ""
for l in lens_list {
  let has_worker = l == "D2" || l == "D7" || l == "D9"
  if !has_worker || !configured.includes(l) {
    bad_lens = l
  }
}
if lens_list.length == 0 {
  bad_lens = "(empty)"
}
if bad_lens != "" {
  let _ = @`Tell the user: /quality-loop refused to start — lens "${bad_lens}" is not runnable. A lens id must have BOTH a quality/surfaces.json entry AND a worker dispatch arm in quality-loop.theta (worker-backed today: D2, D7, D9). surfaces.json configures:
${lenses_out}`?
  return "refused: unknown lens " + bad_lens
}

let baseline = bash({ command: "{ " + gate_cmd + " ; } >/dev/null 2>&1 && echo GATE_PASS || echo GATE_FAIL", timeout: 3600 })?
if !baseline.includes("GATE_PASS") {
  let _ = @`Tell the user: /quality-loop refused to start — the offline gate is already red on the untouched tree, so fix failures could not be attributed. Fix the baseline first (gate: ${gate_cmd}).`?
  return "refused: red baseline"
}

// The per-tree gate: same gate, bounded test-runner width. vitest 2.x rejects
// a maxWorkers below its default minWorkers, so both ends are pinned.
let tree_gate_cmd = gate_cmd.replace("npm test", "npm test -- --minWorkers=1 --maxWorkers=" + tree_workers)
let repo_root = bash({ command: "pwd -W 2>/dev/null || pwd" })?.trim()

let mut cycle = 0
let mut converged = false
let mut report = ""
let mut total_filed = 0
let mut total_confirmed = 0
let mut total_questionable = 0
let mut total_clusters_fixed = 0
let mut total_clusters_reverted = 0
let mut total_picked = 0
let mut total_deferred = 0

while cycle < max_cycles && !converged {
  cycle += 1
  let wave = bash({ command: "date -u +qw%Y%m%d%H%M%S" })?.trim()
  let review_sha = bash({ command: "git rev-parse HEAD" })?.trim()

  // Prune at wave START, not at the previous wave's end: anything a halted
  // run left behind is reclaimed here (docs/how-to/fan-out-into-git-worktrees.md).
  let _ = bash({ command: sweep_cmd(), timeout: 600 })?

  // ---- 1. what needs review, per lens; 2. shard the due surfaces ----
  // review() runs every wave and is internally incremental; convergence is
  // judged AFTER triage, on the open backlog alone (RFC 0009 Phase 8 §A).
  // Rows are "lens<TAB>manifest"; ONE par-for dispatches all lenses' shards.
  let mut review_rows: array<string> = []
  let mut reviewed_lenses = ""
  for l in lens_list {
    let need_n = bash({ command: "node tools/quality/store.mjs needs-review --lens " + l + " | wc -l" })?.trim()
    if need_n != "0" {
      reviewed_lenses = reviewed_lenses == "" ? l : reviewed_lenses + " " + l
      let mut mans: array<string> = []
      mans = lines(bash({ command: "node tools/quality/store.mjs shard --lens " + l + " --wave " + wave + " --target-loc " + shard_loc + " --max-shards " + review_cap })?)
      for m in mans {
        review_rows = review_rows.concat([l + "\t" + m])
      }
    }
  }

  // ---- 3. run the lens workers over all rows in ONE parallel fan-out ----
  if review_rows.length > 0 {
    let reviews = par for row in review_rows max parallel {
      let mut cols: array<string> = []
      cols = row.split("\t")
      let mut s = ReviewSummary { shard: cols[1], filed: -1, notes: "no worker dispatched for lens " + cols[0] }
      if cols[0] == "D2" {
        s = lens_d2_cruft(cols[1], wave, budget)?
      } else if cols[0] == "D7" {
        s = lens_d7_testquality(cols[1], wave, budget)?
      } else if cols[0] == "D9" {
        s = lens_d9_placement(cols[1], wave, budget)?
      }
      s
    }
    let mut i = 0
    while i < review_rows.length {
      let mut cols: array<string> = []
      cols = review_rows[i].split("\t")
      let filed = match reviews[i] {
        Ok(s) => s.filed,
        Err(_) => -1,
      }
      if filed >= 0 {
        // Reviewed at review_sha: later fix commits re-dirty these files, so
        // the next cycle re-reviews exactly what the fixes touched.
        let _ = bash({ command: "node tools/quality/store.mjs mark-reviewed --lens " + cols[0] + " --sha " + review_sha + " --manifest " + cols[1] })?
        total_filed += filed
      } else {
        report = report + "wave " + wave + ": review shard failed (files stay due): " + review_rows[i] + "\n"
      }
      i += 1
    }
  }

  // ---- 4. triage every candidate in intake (leftovers included) ----
  let cand_n = bash({ command: "ls -1 quality/intake/*.md 2>/dev/null | wc -l" })?.trim()
  if cand_n != "0" {
    let mut cands: array<string> = []
    cands = lines(bash({ command: "ls -1 quality/intake/*.md 2>/dev/null | sort" })?)
    let verdicts = par for c in cands max parallel {
      triage_finding(c)?
    }
    let mut j = 0
    while j < cands.length {
      let v = match verdicts[j] {
        Ok(t) => t,
        Err(e) => TriageVerdict { verdict: "questionable", reason: "triage worker failed: " + e.kind },
      }
      if v.verdict == "confirmed" {
        let _ = bash({ command: "node tools/quality/store.mjs accept --finding " + cands[j] })?
        total_confirmed += 1
      } else if v.verdict == "questionable" {
        // Stays in intake/ as the owner queue; re-triaged next cycle. Never a
        // convergence signal - a questionable is a human's call, not the
        // loop's work item.
        total_questionable += 1
      } else {
        let _ = bash({ command: "node tools/quality/store.mjs reject --finding " + cands[j] + " --verdict " + v.verdict })?
      }
      j += 1
    }
  }

  // ---- store commit: review state + accepted/rejected findings ----
  let lens_suffix = reviewed_lenses == "" ? "" : " [" + reviewed_lenses + "]"
  let _ = bash({ command: "git add -A quality && (git diff --cached --quiet || git commit -m \"quality: " + wave + " review pass" + lens_suffix + "\")" })?

  // ---- 5. convergence: the open backlog, judged after triage ----
  let open_n = bash({ command: "node tools/quality/store.mjs open-count" })?.trim()
  if open_n == "0" {
    converged = true
    report = report + "wave " + wave + ": open backlog empty after triage - converged.\n"
  }

  // ---- 6. fix phase: one git worktree per cluster, fanned out in parallel ----
  if !converged {
    let mut rows: array<string> = []
    rows = lines(bash({ command: "node tools/quality/store.mjs clusters --wave " + wave + " --max " + cluster_max })?)

    // Up to `parallel` manifests per wave; the rest wait for the next wave
    // (the loop re-clusters every wave, so nothing is lost).
    let mut picked: array<Pick> = []
    let mut ri = 0
    while ri < rows.length {
      let mut cols: array<string> = []
      cols = rows[ri].split("\t")
      if picked.length < parallel {
        picked = picked.concat([Pick { key: cols[0], manifest_rel: cols[1], manifest_abs: repo_root + "/" + cols[1], tree: "" }])
      } else {
        total_deferred += 1
      }
      ri += 1
    }

    let mut work: array<Pick> = []
    for p in picked {
      let out = bash({ command: provision_cmd(wave, p.key.replace("/", "__")), timeout: 900 })?
      let mut got: array<string> = []
      got = lines(out)
      let tree = got.length > 0 ? got[got.length - 1] : "PROVISION_FAIL"
      if tree.includes("PROVISION_FAIL") {
        report = report + "wave " + wave + ": cluster " + p.key + " skipped - worktree provisioning failed\n"
      } else {
        work = work.concat([Pick { key: p.key, manifest_rel: p.manifest_rel, manifest_abs: p.manifest_abs, tree: tree }])
      }
    }
    total_picked += work.length

    // One isolated child per tree: `cwd` relocates the callee's side effects
    // (edits, gate runs, the commit), never its identity - the child still
    // loads THIS tree's worker code (RFC 0009 §4, identity/location).
    let reports = par for w in work max parallel {
      invoke<TreeFixReport>("./workers/fix-cluster-tree.theta", w.manifest_abs, w.key, wave, tree_gate_cmd, "") with { cwd: w.tree }?
    }

    let mut greens: array<Green> = []
    let mut gi = 0
    while gi < work.length {
      let rep = match reports[gi] {
        Ok(r) => r,
        Err(e) => TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: "tree worker failed: " + e.kind + " - " + e.message },
      }
      if rep.ok && rep.fixed_confirmed.length > 0 {
        greens = greens.concat([Green { key: work[gi].key, manifest_rel: work[gi].manifest_rel, manifest_abs: work[gi].manifest_abs, sha: rep.sha, fixed: rep.fixed_confirmed.join(",") }])
      } else {
        total_clusters_reverted += 1
        report = report + "wave " + wave + ": cluster " + work[gi].key + " not fixed in its worktree - " + rep.notes + "\n"
      }
      gi += 1
    }

    // ---- 7. integrate sequentially: cherry-pick, ONE batch gate, revert last-to-first ----
    let mut applied: array<Green> = []
    let mut retries: array<Retry> = []
    // The failure output carries repo paths, so discriminate on the failure
    // marker (always present on that path), never on CP_OK (a path could
    // contain it).
    for g in greens {
      let cp = bash({ command: cherry_pick_cmd(g.sha) })?
      if !cp.includes("CP_FAIL") {
        applied = applied.concat([g])
      } else {
        // An abort that failed leaves the main tree mid-pick: every later
        // pick would fail and the batch gate would measure a dirty tree.
        // Halt at the boundary instead.
        let residue_n = bash({ command: "git status --porcelain | wc -l" })?
        if residue_n.trim() != "0" {
          let residue = bash({ command: "git status --porcelain | head -20" })?
          let _ = bash({ command: sweep_cmd(), timeout: 600 })?
          let conflicted_key = g.key
          let _ = @`Tell the user: /quality-loop halted at a safe boundary — cherry-picking cluster ${conflicted_key} (wave ${wave}) conflicted and the abort left the tree dirty. Manual cleanup needed:
${residue}`?
          return "halted: unclean cherry-pick abort"
        }
        retries = retries.concat([Retry { key: g.key, manifest_rel: g.manifest_rel, manifest_abs: g.manifest_abs, sha: g.sha, conflicts: conflicted_paths(cp) }])
      }
    }

    // ---- 7b. rebase-and-retry ----
    // Parts are file-disjoint over the paths their issues CITE, but two lanes
    // can still both extend one shared module no issue cites (wave
    // qw20260912112713: tests__p1 and tests__p4 each appended exports to
    // tests/helpers/e2e-s1.ts). Such a lane is re-run ONCE, sequentially, in a
    // fresh worktree at the integrated head - its siblings' changes are then
    // already in place to build on - with the conflict as its seed guidance.
    // A second conflict, or a red retry, drops the lane; its issues stay open.
    for r in retries {
      report = report + "wave " + wave + ": cluster " + r.key + " cherry-pick conflicted on " + r.conflicts + " - retrying on the integrated head\n"
      let out = bash({ command: provision_cmd(wave, r.key.replace("/", "__") + "-retry"), timeout: 900 })?
      let mut got: array<string> = []
      got = lines(out)
      let tree = got.length > 0 ? got[got.length - 1] : "PROVISION_FAIL"
      if tree.includes("PROVISION_FAIL") {
        total_clusters_reverted += 1
        report = report + "wave " + wave + ": cluster " + r.key + " retry skipped - worktree provisioning failed, issues stay open\n"
      } else {
        let seed = "RETRY after an integration conflict: this cluster's previous fix (commit " + r.sha + ", now discarded) conflicted with sibling lanes' already-integrated changes on: " + r.conflicts + ". This tree is at the integrated head, so those siblings' changes - including any new tests/helpers/* exports - are ALREADY present: reuse them, do not re-add them, and re-apply this cluster's fixes on top."
        let rep = match invoke<TreeFixReport>("./workers/fix-cluster-tree.theta", r.manifest_abs, r.key, wave, tree_gate_cmd, seed) with { cwd: tree } {
          Ok(x) => x,
          Err(e) => TreeFixReport { ok: false, sha: "", fixed_confirmed: [], notes: "tree worker failed: " + e.kind + " - " + e.message },
        }
        if rep.ok && rep.fixed_confirmed.length > 0 {
          let cp2 = bash({ command: cherry_pick_cmd(rep.sha) })?
          if !cp2.includes("CP_FAIL") {
            applied = applied.concat([Green { key: r.key, manifest_rel: r.manifest_rel, manifest_abs: r.manifest_abs, sha: rep.sha, fixed: rep.fixed_confirmed.join(",") }])
          } else {
            total_clusters_reverted += 1
            report = report + "wave " + wave + ": cluster " + r.key + " conflicted again on retry (" + conflicted_paths(cp2) + ") - dropped, issues stay open\n"
          }
        } else {
          total_clusters_reverted += 1
          report = report + "wave " + wave + ": cluster " + r.key + " retry not fixed in its worktree - " + rep.notes + "\n"
        }
      }
    }

    let mut kept = applied.length
    if applied.length > 0 {
      let batch = bash({ command: "{ " + gate_cmd + " ; } >/dev/null 2>&1 && echo GATE_PASS || echo GATE_FAIL", timeout: 3600 })?
      let mut batch_ok = batch.includes("GATE_PASS")
      while !batch_ok && kept > 0 {
        // Every branch was gated alone in its own tree and parts are
        // file-disjoint over cited paths (uncited shared files can still
        // interact - see 7b), so a red batch is rare; recover by dropping
        // the cherry-picks last-to-first, re-gating after each drop.
        kept -= 1
        let _ = bash({ command: "git reset --hard HEAD~1 >/dev/null 2>&1" })?
        let residue_n = bash({ command: "git status --porcelain | wc -l" })?
        if residue_n.trim() != "0" {
          let residue = bash({ command: "git status --porcelain | head -20" })?
          let _ = bash({ command: sweep_cmd(), timeout: 600 })?
          let dropped_key = applied[kept].key
          let _ = @`Tell the user: /quality-loop halted at a safe boundary — while reverting a red integration batch (wave ${wave}, dropped cherry-pick for cluster ${dropped_key}), the tree still holds leftover changes. Manual cleanup needed:
${residue}`?
          return "halted: unclean revert"
        }
        let regate = bash({ command: "{ " + gate_cmd + " ; } >/dev/null 2>&1 && echo GATE_PASS || echo GATE_FAIL", timeout: 3600 })?
        batch_ok = regate.includes("GATE_PASS")
        report = report + "wave " + wave + ": batch gate red - dropped cluster " + applied[kept].key + ", gate now " + (batch_ok ? "green" : "still red") + "\n"
      }
      if !batch_ok {
        let _ = bash({ command: sweep_cmd(), timeout: 600 })?
        let _ = @`Tell the user: /quality-loop halted at a safe boundary — the offline gate is still red (wave ${wave}) after dropping every cherry-pick of this wave, so the redness predates the fixes. Investigate the baseline (gate: ${gate_cmd}).`?
        return "halted: red baseline after full revert"
      }
    }

    // ---- 8. store writes: orchestrator only, after integration ----
    let mut si = 0
    while si < applied.length {
      if si < kept {
        let _ = bash({ command: "node tools/quality/store.mjs resolve --manifest " + applied[si].manifest_rel + " --fixed " + applied[si].fixed })?
        total_clusters_fixed += 1
        report = report + "wave " + wave + ": cluster " + applied[si].key + " fixed in its worktree and integrated\n"
      } else {
        total_clusters_reverted += 1
        report = report + "wave " + wave + ": cluster " + applied[si].key + " dropped by the batch gate - issues stay open\n"
      }
      si += 1
    }
    let _ = bash({ command: "git add -A quality && (git diff --cached --quiet || git commit -m \"quality: " + wave + " fix batch\")" })?

    // Trees are disposable: the failure paths above sweep before they halt, so
    // no wave can leak one. (The how-to keeps failed trees for autopsy until
    // the next wave; here the wrapper already reverted in-tree, so there is
    // nothing left to inspect and a leaked tree would pin a stale HEAD.)
    let swept = bash({ command: sweep_cmd(), timeout: 600 })?
    if swept.includes("SWEEP_SKIP") {
      report = report + "wave " + wave + ": a worktree could not be removed (its node_modules link is still in place) - remove it by hand\n"
    }
  }

  // ---- 9. push, then next cycle (fix commits re-dirty fixed files) ----
  if push {
    let pushed = bash({ command: "git push >/dev/null 2>&1 && echo PUSH_OK || echo PUSH_FAIL" })?
    if !pushed.includes("PUSH_OK") {
      report = report + "wave " + wave + ": git push FAILED (continuing; push manually)\n"
    }
  }
  let head = bash({ command: "git log --oneline -1" })?
  report = report + "wave " + wave + ": done, head now " + head.trim() + "\n"
}

// ---------------------------------------------------------------- report
// Prompt mode: the final value is invisible; this closing query IS the
// user-facing summary.
let intake_n = bash({ command: "ls -1 quality/intake/*.md 2>/dev/null | wc -l" })?.trim()
let open_left = bash({ command: "node tools/quality/store.mjs open-count" })?.trim()
@`Report the quality-loop outcome to the user, concisely:
- cycles run: ${cycle} of ${max_cycles}, converged (open backlog empty): ${converged}
- candidates filed: ${total_filed}, confirmed: ${total_confirmed}, questionable verdicts issued (cumulative; live queue is the intake count below): ${total_questionable}
- clusters picked into worktrees: ${total_picked}, deferred to a later wave: ${total_deferred}
- clusters fixed and integrated: ${total_clusters_fixed}, clusters not integrated (reverted, conflicted, or dropped): ${total_clusters_reverted}
- open issues remaining: ${open_left}
- awaiting human ruling (questionable candidates in quality/intake/): ${intake_n}
- log:
${report}
Remind the user: quality/issues/ holds open confirmed issues, quality/resolved/ holds fixed ones, quality/intake/ holds questionable candidates awaiting a human ruling, and quality/state.json records what was reviewed when. Re-running /quality-loop continues from that state.`
